# MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/mashallah
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mashallah"
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_URL="https://your-vercel-app.vercel.app"
PORT=4000
# Used only by `npm run seed` to create the two owner accounts
OWNER1_NAME="Owner One"
OWNER1_EMAIL="owner1@example.com"
OWNER1_PASSWORD="ChangeMe-123"
OWNER2_NAME="Owner Two"
OWNER2_EMAIL="owner2@example.com"
OWNER2_PASSWORD="ChangeMe-456"
