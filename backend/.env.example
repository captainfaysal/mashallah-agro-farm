# Supabase: Project Settings > Database > Connection string
# Pooled (port 6543) for the app, direct (port 5432) for migrations
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres"
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_URL="http://localhost:5173"
PORT=4000
# Used only by `npm run seed` to create the two owner accounts
OWNER1_NAME="Owner One"
OWNER1_EMAIL="owner1@example.com"
OWNER1_PASSWORD="ChangeMe-123"
OWNER2_NAME="Owner Two"
OWNER2_EMAIL="owner2@example.com"
OWNER2_PASSWORD="ChangeMe-456"
